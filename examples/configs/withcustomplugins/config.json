{
  "$schema": "https://www.getbifrost.ai/schema",
  "plugins": [
    {
      "enabled": true,
      "name": "pii-masking",
      "path": "/app/plugins/pii-masking.so",
      "config": {
        "enable": true,
        "mask_phone": true,
        "mask_email": true,
        "mask_id_card": true,
        "mask_bank_card": true,
        "mask_ip": true,
        "log_desensitized": true,
        "desensitization_rules": [
          {
            "provider": "openai",
            "model": "gpt-4o"
          }
        ]
      }
    },
    {
      "enabled": true,
      "name": "vision-extension",
      "path": "/app/plugins/vision-extension.so",
      "config": {
        "enabled": true,
        "target_models": [
          "gpt-3.5-turbo",
          "claude-3-haiku-20240307"
        ],
        "image_placeholder": "[Image provided: this model does not support image input. Image URL: {url}, Detail: {detail}]"
      }
    }
  ]
}
